{
  "name": "temencad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cli": "node bin/temencad.mjs",
    "prebuild": "node scripts/api-text.mjs",
    "api": "node bin/temencad.mjs api",
    "test": "node bin/temencad.mjs test test/",
    "core:native": "cmake -S core -B build/native && cmake --build build/native -j8",
    "core:wasm": "emcmake cmake -S core -B build/wasm && cmake --build build/wasm -j8",
    "core:test": "node core/test/smoke.mjs",
    "core:diff": "node core/test/diff.mjs",
    "core:export": "node core/test/export-parity.mjs",
    "core:pick": "node core/test/pick-parity.mjs"
  },
  "devDependencies": {
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.2",
    "three": "^0.187.0"
  },
  "bin": {
    "temencad": "bin/temencad.mjs"
  }
}
